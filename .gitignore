# ==========================================
# LAN Courier - Root .gitignore
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
*.pem
*.key

# IDE & Editor Directories
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node.js & React Frontend
node_modules/
dist/
dist-ssr/
build/
.cache/
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Go Binaries & Artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
server/server.exe
server/bin/
bin/

# Temporary & Scratch Files
tmp/
temp/
scratch/
*.tmp
*.bak
